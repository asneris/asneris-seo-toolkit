{
  "name": "asneris/seo-toolkit",
  "description": "WordPress SEO Plugin - Development Dependencies",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=*/node_modules/*,*/vendor/*,*/build/* .",
    "phpcbf": "phpcbf --standard=WordPress --extensions=php --ignore=*/node_modules/*,*/vendor/*,*/build/* .",
    "phpstan": "phpstan analyse --level=6 --memory-limit=512M includes templates",
    "phpstan-high": "phpstan analyse --level=8 --memory-limit=512M includes templates",
    "test": "phpunit --configuration phpunit.xml.dist",
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "fix": "@phpcbf"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
